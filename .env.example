# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================
# SerpAPI Configuration (Google Shopping)
# ============================================
# Get your API key from: https://serpapi.com/
# SerpAPI fetches real fashion products with professional images from Google Shopping
# Free tier: 100 searches/month
# Pricing: https://serpapi.com/pricing

VITE_SERPAPI_KEY=your_serpapi_key_here

# ============================================
# YouCam API Configuration (Virtual Try-On)
# ============================================
# Get your API key from: https://yce.makeupar.com/ai-api
# YouCam provides AI-powered virtual try-on for fashion items
# Pricing: ~$0.10 per try-on

VITE_YOUCAM_API_KEY=your_youcam_api_key_here
VITE_YOUCAM_SECRET_KEY=your_youcam_secret_key_here
VITE_YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
